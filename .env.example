# Copia este archivo como .env y ajusta la URL de la API.
#
# - Desarrollo en web (Vite):        http://localhost:8000
# - Emulador Android:                http://10.0.2.2:8000
# - Móvil físico en la misma red:    http://IP_DE_TU_PC:8000  (ej. http://192.168.1.20:8000)
# - Producción:                      https://tu-dominio.com
#
# En desarrollo nativo, capacitor.config.json sirve la app con androidScheme "http"
# y cleartext habilitado para evitar el bloqueo de mixed content. En producción
# usa HTTPS real y elimina esas opciones.
#
# Recuerda añadir el origen del WebView de Capacitor a CORS_ORIGINS en el backend
# (capacitor://localhost, https://localhost y http://localhost en desarrollo).
VITE_API_URL=http://localhost:8000
